    <!-- head -->
<%- include('../includes/head.ejs') %>
    <!-- header -->
<%- include('../includes/heading.ejs') %>
    <!-- link -->
<%- include('../includes/navigation.ejs') %>


<main>
    <% if(products.length>0){ %>
    <ul class="cart__item-list">
        <% products.forEach(p=>{ %>
        <li class="cart__item">
            <div>
                <img src="<%= p.imageUrl %>" class="img-thumbnail" alt="">
            </div>
            <h1><%= p.title %></h1>
            <h2><%= p.quantity %></h2>
            <form action="">
                <button class="btn-remove">حذف</button>
            </form>
        </li>
        <% }); %>
    </ul>
    <% }else{ %>
        <h1>محصولی یافت نشد</h1>
        <% } %>
</main>



    <!-- end html -->
<%- include('../includes/end.ejs') %>