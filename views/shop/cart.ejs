    <!-- head -->
<%- include('../includes/head.ejs') %>
    <!-- header -->
<%- include('../includes/heading.ejs') %>
    <!-- link -->
<%- include('../includes/navigation.ejs') %>


<main>
    <% if(products.length>0){ %>
    <ul class="cart__item-list">
        <% products.forEach(p=>{ %>
        <li class="cart__item">
            <div>
                <img src="<%= p.productId.imageUrl %>" class="img-thumbnail" alt="">
            </div>
            <h1><%= p.productId.title %></h1>
            <h2><%= p.quantity %></h2>
            <form action="/cart-delete-item" method="post">
                <button class="btn-remove" type="submit">حذف</button>
                <input type="hidden" value="<%= p.productId._id %>" name="productId">
            </form>
        </li>
        <% }); %>
    </ul>
    <div class="countainer">
        <form action="/creat-order" method="post">
            <button class="btn btn-order" type="submit">سفارش محصولات</button>
        </form>
    </div>
    <% }else{ %>
        <h1>محصولی یافت نشد</h1>
        <% } %>
</main>



    <!-- end html -->
<%- include('../includes/end.ejs') %>